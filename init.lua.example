-- ~/.hammerspoon/init.lua
-- The two lines SnapNuts needs. Everything else in this file is yours.

hs.loadSpoon("SnapNuts")

-- Optional settings. Defaults shown.
-- spoon.SnapNuts.gap = 0             -- pixels between snapped windows and the screen edge
-- spoon.SnapNuts.tileGap = 4         -- pixels between tiled windows
-- spoon.SnapNuts.portraitAware = true -- thirds become bands on a portrait screen

-- Optional: change a shortcut. One chord, or a list of chords.
-- spoon.SnapNuts:bindHotkeys({
--   undo = {{"cmd", "ctrl"}, "z"},
--   tileAll = {{{"cmd", "alt"}, "pad0"}, {{"cmd", "ctrl", "alt"}, "0"}},
-- })

spoon.SnapNuts:start()
